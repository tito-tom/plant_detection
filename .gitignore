# ============================================================
#  YOLO-Seg-Root  —  .gitignore
# ============================================================

# ── Dataset (images & labels) ────────────────────────────────
# Keep data.yaml (config) but not the actual images/labels
02_model_training/data/images/
02_model_training/data/labels/
data/

# ── Model Weights ────────────────────────────────────────────
# Pretrained base weights
*.pt
*.pth
*.onnx
*.torchscript
*.engine       # TensorRT
*.tflite
*.pb

# ── Training & Prediction Outputs ─────────────────────────────
# Checkpoints, plots, CSVs, and predicted sample images
output_train/
runs/
predictions_box/
predictions_onnx/

# ── Hyperparameter Tuning ────────────────────────────────────
# Optuna study database
*.db
optuna_dashboard.log

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
.env/

# Conda env is pinned via environment.yml — no need to commit the env folder
# (miniconda/anaconda envs are stored outside the project anyway)

# ── Jupyter / IPython ────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS / Editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ── Logs & Temp ──────────────────────────────────────────────
*.log
tmp/
temp/
.scratch_*

# output
02_model_training/predictions_box/*

# data preparation
01_data_preparation/annotation-xml/*