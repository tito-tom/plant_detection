# ============================================================
#  YOLO-Seg-Root  —  .gitignore
# ============================================================

# ── Dataset (images & labels) ────────────────────────────────
# Keep data.yaml (config) but not the actual images/labels
02_model_training/data/images/
02_model_training/data/labels/
data/

# ── Model Weights ────────────────────────────────────────────
# Pretrained base weights
*.pt
*.pth
*.onnx
*.torchscript
*.engine       # TensorRT
*.tflite
*.pb

# ── Training Outputs ─────────────────────────────────────────
# Checkpoints, plots, CSVs generated by train.py
output_train/
runs/

# ── Hyperparameter Tuning ────────────────────────────────────
# Optuna study database
*.db
optuna_dashboard.log

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
.env/

# Conda env is pinned via environment.yml — no need to commit the env folder
# (miniconda/anaconda envs are stored outside the project anyway)

# ── Jupyter / IPython ────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS / Editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ── Logs & Temp ──────────────────────────────────────────────
*.log
tmp/
temp/
.scratch_*

# ── Processed / raw data outside the packaged dataset ────────
# Uncomment if you keep raw XMLs or processed splits locally
# data/raw/
# data/processed/

